# Copy to .env and adjust. .env is not committed.
# All variables are described in docs/CONFIGURATION.md

# --- Web UI -------------------------------------------------------------------
# Logins (HTTP basic auth), comma-separated: user1:pass1,user2:pass2
# Without an entry the web UI is only reachable inside the container.
WEBUI_USERS=

# --- Registration and autostart ----------------------------------------------
# Phrase from the web UI's registration dialog. If set, the container registers
# again on every start (the manager forgets its registration on restart).
REGISTER_PHRASE=
# Start the configured servers automatically after the container starts (true/false)
AUTOSTART=false
# Restart the container when the web UI answered once and then stays silent for this
# many minutes (the manager hangs); 0 = off. Running races end with the restart.
WEBUI_WATCHDOG_MINUTES=5

# Save all server settings to data/backups/ every this many hours (only when something
# changed; 0 = off) and keep the newest BACKUP_KEEP files. Restore: import in the web UI.
BACKUP_HOURS=24
BACKUP_KEEP=14

# --- Server files (SteamCMD) --------------------------------------------------
UPDATE_ON_START=true
# Retries for the SteamCMD update and the pause between them (seconds). SteamCMD
# occasionally fails right after its self-update ("Missing configuration").
STEAMCMD_RETRIES=5
STEAMCMD_RETRY_DELAY=10
# Only needed if the anonymous download fails ("No subscription")
STEAM_USER=
STEAM_PASS=

# --- Image / data -------------------------------------------------------------
# Image name (build step, tarball or registry)
# Published image: RR_IMAGE=ghcr.io/<owner>/<repo>:latest with RR_PULL_POLICY=always
# and ACCEPT_MICROSOFT_DOTNET_LICENSE=yes
RR_IMAGE=docker-rr-server:local
# missing: only pull if not present locally (locally built/loaded images)
RR_PULL_POLICY=missing
# Published image only: it does not contain the Microsoft .NET Framework 4.8; the first
# start downloads and installs it into RR_DATA_DIR/wine. "yes" accepts Microsoft's
# license terms for it (README.md#licenses). Not needed for a self-built image.
ACCEPT_MICROSOFT_DOTNET_LICENSE=
# Data directory, mounted on /data (subdirectories raceroom/, appdata/, userdata/, wine/
# are created on start). Must belong to PUID/PGID.
# Use an absolute path for Docker managers such as Komodo/Portainer.
RR_DATA_DIR=./data

# --- Build step only (docker-compose.build.yml) -------------------------------
# UID/GID of the server user in the image (must own RR_DATA_DIR)
PUID=1000
PGID=1000
# Image variant: full (.NET baked in) or public (without .NET, as published)
RR_TARGET=full

# --- Traefik (docker-compose.traefik.yml only) --------------------------------
TRAEFIK_HOST=
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
