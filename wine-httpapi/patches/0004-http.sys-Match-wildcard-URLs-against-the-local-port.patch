From 051d893051d7ccd7af8bf5e43541d85a73a4feb5 Mon Sep 17 00:00:00 2001
From: Tomek Kochanowsy <39644556+Checker8763@users.noreply.github.com>
Date: Tue, 6 Oct 2026 21:19:44 +0200
Subject: [PATCH 4/4] http.sys: Match wildcard URLs against the local port.

For "http://+:port/" and "http://*:port/" registrations, host_matches()
compared the port in the Host header with the registered port. A Host
header without a port passed NULL to strncmp(), and a reverse proxy
forwarding "Host: example.com" never matched, so the request hung.
Windows matches wildcard registrations on the port the connection was
accepted on.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
SPDX-License-Identifier: LGPL-2.1-or-later
---
 dlls/http.sys/http.c | 17 +++++++++++++----
 1 file changed, 13 insertions(+), 4 deletions(-)

diff --git a/dlls/http.sys/http.c b/dlls/http.sys/http.c
index 35ec447..ed41b22 100644
--- a/dlls/http.sys/http.c
+++ b/dlls/http.sys/http.c
@@ -56,6 +56,7 @@ struct connection
     char *buffer;
     unsigned int len, size;
     bool shutdown;
+    unsigned short local_port; /* port the connection was accepted on */
 
     /* If there is a request fully received and waiting to be read, the
      * "available" parameter will be TRUE. Either there is no queue matching
@@ -135,6 +136,12 @@ static void accept_connection(SOCKET socket)
         return;
     }
     conn->size = 8192;
+    {
+        struct sockaddr_in addr;
+        int addr_len = sizeof(addr);
+        if (!getsockname(peer, (struct sockaddr *)&addr, &addr_len))
+            conn->local_port = ntohs(addr.sin_port);
+    }
     WSAEventSelect(peer, request_event, FD_READ | FD_CLOSE);
     ioctlsocket(peer, FIONBIO, &one);
     conn->socket = peer;
@@ -378,7 +385,7 @@ static unsigned int compare_paths(const char *queue_path, const char *conn_path,
         return 0;
 }
 
-static BOOL host_matches(const struct url *url, const char *conn_host)
+static BOOL host_matches(const struct url *url, const struct connection *conn, const char *conn_host)
 {
     size_t host_len;
 
@@ -387,9 +394,11 @@ static BOOL host_matches(const struct url *url, const char *conn_host)
 
     if (url->url[7] == '+' || url->url[7] == '*')
     {
+        /* Wildcard hosts match any Host header; like Windows, compare the
+         * port the connection arrived on, not the one in the Host header
+         * (which may be missing or differ behind a reverse proxy). */
         const char *queue_port = strchr(url->url + 7, ':');
-        host_len = strchr(queue_port, '/') - queue_port - 1;
-        if (!strncmp(queue_port, strchr(conn_host, ':'), host_len))
+        if (queue_port && strtol(queue_port + 1, NULL, 10) == conn->local_port)
             return TRUE;
     }
     else
@@ -426,7 +435,7 @@ static struct url *url_matches(const struct connection *conn, const struct reque
 
     LIST_FOR_EACH_ENTRY(url, &queue->urls, struct url, entry)
     {
-        if (host_matches(url, conn_host))
+        if (host_matches(url, conn, conn_host))
         {
             queue_path = strchr(url->url + 7, '/');
             if (!queue_path)
